# Copy to .env (never commit .env). Everything is optional for the local demo.

# Claude (AI extraction, audit reasoning, copilot). Without it the app runs on
# the offline rules + IsolationForest auditor and a heuristic document parser.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5

# Live grid carbon intensity for the Design Lab (https://www.electricitymaps.com/)
ELECTRICITYMAPS_TOKEN=

# Public testnet deployment (contracts/): npm run deploy:sepolia
SEPOLIA_RPC_URL=
AMOY_RPC_URL=
DEPLOYER_PRIVATE_KEY=
# Backend against a public chain: RPC_URL=<same RPC>, and per-actor keys
# ACTOR_KEY_DESIGNER=, ACTOR_KEY_FAB_TW=, ACTOR_KEY_AI_AUDITOR=, ...
# PUBLIC_BASE_URL=https://your-demo-host
